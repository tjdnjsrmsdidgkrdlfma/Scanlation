[Unit]
Description=translate llama-server (gemma-4-26B-A4B, MI50)
After=network-online.target
Wants=network-online.target

[Service]
# Index is from `llama-server --list-devices` run WITHOUT this env. Pin only this
# way: --device leaves the vision encoder (mtmd) free to pick another card, and
# anything that hides a render node (InaccessiblePaths=) renumbers the survivors.
Environment="GGML_VK_VISIBLE_DEVICES=1"
ExecStart=/opt/llama/llama.cpp/build-vulkan/bin/llama-server -hf unsloth/gemma-4-26B-A4B-it-qat-GGUF -ngl 99 -c 16384 --parallel 8 --n-predict 1024 --host 0.0.0.0 --port 8080
Restart=on-failure

[Install]
WantedBy=multi-user.target

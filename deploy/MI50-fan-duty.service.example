[Unit]
Description=MI50 fan fixed duty at boot (stopgap until fancontrol)
# The EC/BIOS resumes fan control on every boot (manual pwm does not survive),
# so re-assert the chosen duty once the nct6687 module is up. Fixed duty only --
# no GPU-temperature feedback; that is fancontrol's job (cooling-mi50-fans.md
# Task 4), which replaces this unit.
After=systemd-modules-load.service

[Service]
Type=oneshot
# hwmon index moves per boot: find the chip by name. 77/255 = 30% (~6,100 rpm,
# the chosen quiet point). Fails visibly if nct6687 is absent (e.g. after a
# kernel update, before the module is rebuilt).
ExecStart=/bin/sh -c 'H=$(grep -l nct6687 /sys/class/hwmon/hwmon*/name | xargs dirname) && echo 1 > $H/pwm4_enable && echo 77 > $H/pwm4'

[Install]
WantedBy=multi-user.target
